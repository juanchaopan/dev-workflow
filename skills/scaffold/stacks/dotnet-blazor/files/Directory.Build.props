<Project>
  <!-- Applies to every .NET project below this directory: version, nullable reference types, the recommended analyzer rules, and the .editorconfig code style checked during the build. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
