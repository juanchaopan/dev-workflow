# Common ignore rules for the repository root. Component directories also have the .gitignore their generators created.

# Operating system and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Personal Claude Code settings
.claude/settings.local.json

# Logs
*.log
