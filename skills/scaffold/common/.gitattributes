# LF line endings everywhere except Windows scripts, so files committed on Windows and Linux never differ by line endings alone.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.woff binary
*.woff2 binary
